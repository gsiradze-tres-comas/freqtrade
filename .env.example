BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/freqtrade_db

# Telegram Bot Configuration (optional)
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# API Server Configuration
API_SERVER_USERNAME=freqtrader
API_SERVER_PASSWORD=your_secure_password_here
API_SERVER_JWT_SECRET=your_random_jwt_secret_here
API_SERVER_WS_TOKEN=your_websocket_token_here

# Trading Configuration
DRY_RUN=true
STAKE_AMOUNT=100
MAX_OPEN_TRADES=5

# Performance Settings
PROCESS_THROTTLE_SECS=2
HEARTBEAT_INTERVAL=30