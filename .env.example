# Binance API Configuration
# Get your API keys from: https://www.binance.com/en/my/settings/api-management
# IMPORTANT: Enable Futures trading in API settings
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET=your_binance_secret_key_here

# PostgreSQL Database Configuration
# Default setup for local development
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=freqtrade_db
DB_USER=postgres
DB_PASSWORD=postgres

# Alternative database for SafeBullRider strategy
DB_NAME_SAFE=freqtrade_safe_db

# Telegram Configuration (Optional)
# Get bot token from @BotFather on Telegram
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Initial Capital for Paper Trading
INITIAL_CAPITAL=10000

# Trading Mode
# NEVER change this to false unless you want to trade with real money\!
DRY_RUN=true
